# Copie para .env e ajuste (o .env não vai para o repositório).
# Rede da LAN usada só pelo container do Tailscale (perfil "app" do docker-compose.yml).
TS_LAN_PARENT=eth0              # placa de rede do servidor ligada à LAN
TS_LAN_SUBNET=192.168.0.0/24
TS_LAN_GATEWAY=192.168.0.1      # roteador da LAN (saída para a internet)
TS_LAN_IP=192.168.0.240         # IP livre, fora da faixa do DHCP
TS_DNS1=1.1.1.1
TS_DNS2=8.8.8.8
